---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import JournalTop from "../../components/JournalTop.astro";
import TrailProgress from "../../components/blog/TrailProgress.astro";
import ReadingWorld from "../../components/blog/ReadingWorld.astro";
import TrailMap from "../../components/blog/TrailMap.astro";
import ProseExtras from "../../components/blog/ProseExtras.astro";
import ReadingLog from "../../components/blog/ReadingLog.astro";
import TrailSound from "../../components/blog/TrailSound.astro";
import { contact, site } from "../../data/content";
import { trailStats } from "../../lib/reading";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
// the next trail: the next newest post, wrapping round to the first
const all = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const next = all.length > 1 ? all[(all.findIndex((p) => p.id === post.id) + 1) % all.length] : undefined;
const { Content } = await render(post);
const { originalUrl, originalSite } = post.data;
const { words, minutes } = trailStats(post.body);
const url = new URL(`/blog/${post.id}`, Astro.site ?? "http://localhost").href;
const blogPosting = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: post.data.pubDate.toISOString(),
  keywords: post.data.tags.join(", "),
  wordCount: words,
  inLanguage: "en",
  url,
  image: Astro.site ? new URL("/og.png", Astro.site).href : undefined,
  publisher: { "@type": "Person", name: site.name, url: Astro.site?.href },
  author: { "@type": "Person", name: site.name, url: Astro.site?.href },
  mainEntityOfPage: originalUrl ?? url,
  ...(originalUrl && { isBasedOn: originalUrl, sameAs: originalUrl }),
};
const crumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: Astro.site?.href },
    { "@type": "ListItem", position: 2, name: "Field notes", item: new URL("/blog", Astro.site ?? "http://localhost").href },
    { "@type": "ListItem", position: 3, name: post.data.title, item: url },
  ],
};
const df = new Intl.DateTimeFormat("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" });
---

<Base
  title={`${post.data.title} — ${site.name}`}
  description={post.data.description}
  canonicalUrl={originalUrl}
  article={{ published: post.data.pubDate, tags: post.data.tags }}
  jsonLd={[blogPosting, crumbs]}
>
  <main class="journal journal-world">
    <ReadingWorld />
    <TrailMap />
    <ProseExtras />
    <JournalTop back={{ href: "/blog", label: "all field notes" }}>
      <TrailSound />
    </JournalTop>

    <article class="paper journal-page">
      <h1 class="journal-title">{post.data.title}</h1>
      <div class="journal-meta">
        <time class="stamp" datetime={post.data.pubDate.toISOString()}>{df.format(post.data.pubDate)}</time>
        <span class="tagline">{minutes} min read</span>
        <span class="tagline">{post.data.tags.map((t) => `#${t}`).join("  ")}</span>
      </div>
      <div class="prose-trail">
        <Content />
      </div>
      {
        originalUrl && (
          <p class="journal-origin">
            Originally published on <a href={originalUrl} rel="noopener" target="_blank">{originalSite ?? "the original site"}</a> on{" "}
            <time datetime={post.data.pubDate.toISOString()}>{df.format(post.data.pubDate)}</time>.
          </p>
        )
      }
      <p class="hand journal-sign">— Rakesh, from basecamp in {site.location}</p>
    </article>

    {
      next && (
        <a class="next-trail paper" href={`/blog/${next.id}`}>
          <span class="hand">Next trail</span>
          <strong>{next.data.title}</strong>
          <span class="next-trail-go">follow Yakku →</span>
        </a>
      )
    }

    <TrailProgress />
    <ReadingLog slug={post.id} />

    <aside class="journal-cta">
      <p>{contact.heading}</p>
      <div class="summit-actions" style="margin-top:0">
        <a class="ink-btn ink-btn-primary" href={`mailto:${site.email}`}>{contact.email}</a>
        <a class="ink-btn" href="/#summit">Climb to the summit</a>
      </div>
    </aside>
  </main>
</Base>
