---
import Stop from "./Stop.astro";
import { site } from "../../data/content";

const ink = "#40302A";
const name = ["Rakesh", "Thapa"];
---

<Stop id="basecamp" label="Basecamp — introduction" class="s-base">
  <Fragment slot="scene">
    <div class="plant teahouse" style="--x:1%;--xm:-34%;--w:calc(var(--yak-w) * 1.25);--wm:150px">
      <svg viewBox="0 0 200 180">
        <g class="smoke">
          <circle cx="150" cy="6" r="7" fill="#FFFDF6" stroke={ink} stroke-width="2"></circle>
          <circle cx="160" cy="-10" r="9" fill="#FFFDF6" stroke={ink} stroke-width="2"></circle>
          <circle cx="172" cy="-30" r="11" fill="#FFFDF6" stroke={ink} stroke-width="2"></circle>
        </g>
        <!-- stone chimney -->
        <rect x="140" y="12" width="16" height="30" rx="2" fill="#A79C90" stroke={ink} stroke-width="3"></rect>
        <path d="M140 22 h16 M140 32 h16 M148 12 v10 M145 22 v10 M151 32 v10" stroke={ink} stroke-opacity=".35" stroke-width="1.5"></path>

        <!-- whitewashed stone walls -->
        <rect x="20" y="72" width="160" height="108" fill="#FBF3E2" stroke={ink} stroke-width="3"></rect>
        <path d="M20 88 q8 -3 16 0 M150 84 q10 -3 20 0 M24 142 q9 -3 18 0 M156 140 q9 -3 18 0 M52 152 q8 -3 16 0 M132 154 q8 -3 16 0" fill="none" stroke={ink} stroke-opacity=".22" stroke-width="2"></path>
        <rect x="20" y="164" width="160" height="16" fill="#CFC4B6" stroke={ink} stroke-width="3"></rect>
        <path d="M40 164 v16 M62 164 v16 M138 164 v16 M160 164 v16" stroke={ink} stroke-opacity=".35" stroke-width="2"></path>

        <!-- corrugated tin roof weighed down with rocks -->
        <path d="M6 72 L 36 30 L 164 30 L 194 72 Z" fill="#2A9D8F" stroke={ink} stroke-width="3" stroke-linejoin="round"></path>
        <path d="M52 30 L 29.5 72 M68 30 L 53 72 M84 30 L 76.5 72 M100 30 V 72 M116 30 L 123.5 72 M132 30 L 147 72 M148 30 L 170.5 72" stroke={ink} stroke-opacity=".28" stroke-width="2"></path>
        <path d="M34 30 H 166" stroke={ink} stroke-width="4" stroke-linecap="round"></path>
        <ellipse cx="60" cy="46" rx="6" ry="4" fill="#A79C90" stroke={ink} stroke-width="2"></ellipse>
        <ellipse cx="128" cy="56" rx="7" ry="4.5" fill="#A79C90" stroke={ink} stroke-width="2"></ellipse>
        <ellipse cx="96" cy="40" rx="5" ry="3.5" fill="#A79C90" stroke={ink} stroke-width="2"></ellipse>

        <!-- prayer flags from the roof pole to the chimney -->
        <path d="M40 30 V -6" stroke={ink} stroke-width="2.5" stroke-linecap="round"></path>
        <circle cx="40" cy="-7" r="2.5" fill="#FFC53D" stroke={ink} stroke-width="1.5"></circle>
        <path d="M40 -4 Q 94 30 148 12" fill="none" stroke={ink} stroke-width="1.5"></path>
        <g stroke={ink} stroke-width="1.5" stroke-linejoin="round">
          <path d="M47 2.3 h8 l-1 9 h-7 Z" fill="#3A86FF"></path>
          <path d="M58 7.5 h8 l-1 9 h-7 Z" fill="#FFFDF6"></path>
          <path d="M68 11.7 h8 l-1 9 h-7 Z" fill="#E85D2F"></path>
          <path d="M79 14.9 h8 l-1 9 h-7 Z" fill="#2A9D8F"></path>
          <path d="M90 17 h8 l-1 9 h-7 Z" fill="#FFC53D"></path>
          <path d="M101 18.1 h8 l-1 9 h-7 Z" fill="#3A86FF"></path>
          <path d="M112 18.1 h8 l-1 9 h-7 Z" fill="#FFFDF6"></path>
          <path d="M122 17.1 h8 l-1 9 h-7 Z" fill="#E85D2F"></path>
          <path d="M133 15.1 h8 l-1 9 h-7 Z" fill="#2A9D8F"></path>
        </g>

        <!-- Sherpa-style windows: black trapezoid surrounds, painted lintels -->
        <path d="M32 102 h36 l5 32 h-46 Z" fill={ink}></path>
        <rect x="28" y="96" width="44" height="6" fill="#E85D2F" stroke={ink} stroke-width="2"></rect>
        <path d="M31 99 h38" stroke="#FFC53D" stroke-width="1.5" stroke-dasharray="3 2"></path>
        <rect x="36" y="105" width="28" height="24" rx="1" fill="#4CC9F0" stroke="#FFFDF6" stroke-width="2"></rect>
        <path d="M50 105 v24 M36 117 h28" stroke="#FFFDF6" stroke-width="2"></path>

        <path d="M132 102 h36 l5 32 h-46 Z" fill={ink}></path>
        <rect x="128" y="96" width="44" height="6" fill="#E85D2F" stroke={ink} stroke-width="2"></rect>
        <path d="M131 99 h38" stroke="#FFC53D" stroke-width="1.5" stroke-dasharray="3 2"></path>
        <rect x="136" y="105" width="28" height="24" rx="1" fill="#FFD166" stroke="#FFFDF6" stroke-width="2"></rect>
        <path d="M150 105 v24 M136 117 h28" stroke="#FFFDF6" stroke-width="2"></path>

        <!-- carved wooden door with a painted lintel and curtain -->
        <path d="M82 114 h36 l4 50 h-44 Z" fill={ink}></path>
        <rect x="78" y="108" width="44" height="6" fill="#E85D2F" stroke={ink} stroke-width="2"></rect>
        <path d="M81 111 h38" stroke="#FFC53D" stroke-width="1.5" stroke-dasharray="3 2"></path>
        <rect x="86" y="117" width="28" height="47" fill="#7C4F2E" stroke={ink} stroke-width="2"></rect>
        <path d="M86 117 h28 v12 q-7 5 -14 0 q-7 5 -14 0 Z" fill="#3A86FF" stroke={ink} stroke-width="2" stroke-linejoin="round"></path>
        <path d="M93 129 v3 M100 129 v3 M107 129 v3" stroke="#FFFDF6" stroke-width="1.5"></path>
        <circle cx="108" cy="148" r="2.5" fill="#FFC53D" stroke={ink} stroke-width="1"></circle>
        <rect x="76" y="164" width="48" height="6" rx="1" fill="#A79C90" stroke={ink} stroke-width="2"></rect>

        <!-- signboard -->
        <rect x="58" y="78" width="84" height="16" rx="2" fill="#FFC53D" stroke={ink} stroke-width="2.5"></rect>
        <text x="100" y="90.5" text-anchor="middle" font-family="Bricolage Grotesque Variable, sans-serif" font-size="10.5" font-weight="800" letter-spacing="1.5" fill={ink}>TEA HOUSE</text>

        <!-- firewood stack -->
        <g stroke={ink} stroke-width="1.5">
          <circle cx="26" cy="159" r="4.5" fill="#B5784A"></circle>
          <circle cx="35" cy="159" r="4.5" fill="#C98D5B"></circle>
          <circle cx="30.5" cy="151" r="4.5" fill="#C98D5B"></circle>
          <circle cx="44" cy="159" r="4.5" fill="#B5784A"></circle>
          <circle cx="39.5" cy="151" r="4.5" fill="#B5784A"></circle>
        </g>
        <path d="M26 159 h.1 M35 159 h.1 M30.5 151 h.1 M44 159 h.1 M39.5 151 h.1" stroke={ink} stroke-width="2" stroke-linecap="round"></path>
      </svg>
    </div>
    <div class="plant chorten" style="--x:92%;--xm:88%;--w:calc(var(--yak-w) * 0.46);--wm:56px">
      <svg viewBox="0 0 80 140">
        <path d="M40 4 L 46 22 H 34 Z" fill="#FFC53D" stroke={ink} stroke-width="2.5" stroke-linejoin="round"></path>
        <path d="M34 22 h12 l2 8 h-16 Z M33 30 h14 l2 8 h-18 Z M32 38 h16 l2 8 h-20 Z" fill="#FFC53D" stroke={ink} stroke-width="2.5" stroke-linejoin="round"></path>
        <rect x="27" y="46" width="26" height="16" fill="#FFFDF6" stroke={ink} stroke-width="2.5"></rect>
        <path d="M32 54 q3 -3 6 0 M42 54 q3 -3 6 0" fill="none" stroke={ink} stroke-width="2"></path>
        <path d="M14 92 C 14 70 26 62 40 62 C 54 62 66 70 66 92 Z" fill="#FFFDF6" stroke={ink} stroke-width="2.5"></path>
        <rect x="10" y="92" width="60" height="16" fill="#FFFDF6" stroke={ink} stroke-width="2.5"></rect>
        <rect x="4" y="108" width="72" height="32" fill="#FFFDF6" stroke={ink} stroke-width="2.5"></rect>
        <path d="M4 120 h72" stroke="#E85D2F" stroke-width="3"></path>
      </svg>
    </div>
    <div class="plant signpost" style="--x:78%;--xm:50%">
      <span class="plank plank-r">Summit · 8,848 m</span>
      <span class="plank plank-l">Kathmandu</span>
      <span class="post"></span>
    </div>
  </Fragment>

  <div class="base">
    <p class="hand base-hello">Namaste, I'm</p>
    <h1 class="base-name" aria-label={site.name}>
      {
        name.map((word) => (
          <span class="base-word" aria-hidden="true">
            {[...word].map((ch, i) => (
              <span class="wob" style={`--i:${i}`}>{ch}</span>
            ))}
          </span>
        ))
      }
    </h1>
    <p class="base-lede">
      AI native product engineer building <mark>thoughtful</mark>, <mark class="mk-teal">reliable</mark> products — from Kathmandu, Nepal.
    </p>
    <p class="hand base-hint">
      scroll, swipe or press → and Yakku starts walking
      <svg width="74" height="30" viewBox="0 0 74 30" aria-hidden="true">
        <path d="M2 18 C 18 4 38 28 66 12" fill="none" stroke={ink} stroke-width="2.5" stroke-linecap="round"></path>
        <path d="M56 6 L 67 11 L 60 21" fill="none" stroke={ink} stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </p>
  </div>
</Stop>
