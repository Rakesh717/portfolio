---
// The world behind a post: a sky that moves from morning toward sunset as you read,
// parallax Himalaya that sink as you climb, a sun that sets behind them, clouds you climb
// up through, and drifting snow.
// Everything sits behind the paper, so the text never changes.
interface Props {
  /** hold the world at one point of the climb instead of following the scroll (0..1) */
  still?: number;
}
const { still } = Astro.props;
const ink = "#40302A";
const clouds = [
  { x: 6, from: -40, speed: 1.5, w: 220, d: 70 },
  { x: 74, from: -10, speed: 1.15, w: 260, d: 95 },
  { x: 38, from: -80, speed: 1.9, w: 180, d: 60 },
  { x: 84, from: -120, speed: 2.45, w: 200, d: 80 },
];
---

<div class="rw" aria-hidden="true" data-rw data-still={still}>
  <div class="rw-sky" data-sky></div>
  <div class="rw-sun" data-sun></div>
  <svg class="rw-peaks" viewBox="0 0 1440 560" preserveAspectRatio="xMidYMax slice">
    <g data-layer="0.35">
      <path d="M0 330 L130 250 L230 310 L360 215 L490 300 L610 250 L760 330 L900 240 L1030 310 L1160 235 L1300 300 L1440 250 V560 H0Z" fill="#C9B6C6" opacity=".75" />
    </g>
    <g data-layer="0.7">
      <path d="M0 420 L170 320 L300 390 L470 260 L610 360 L800 200 L930 310 L1080 240 L1230 340 L1440 270 V560 H0Z" fill="#E5D5D6" stroke={ink} stroke-width="3" stroke-linejoin="round" />
      <path d="M800 200 L760 262 L792 276 L772 318 L820 300 L838 258Z M470 260 L440 304 L468 314 L452 350 L492 330Z" fill="#FFFDF6" />
      <path d="M800 200 V135" stroke={ink} stroke-width="4" stroke-linecap="round" />
      <path d="M800 139 l36 11 l-36 11z" fill="#E85D2F" stroke={ink} stroke-width="3" stroke-linejoin="round" />
    </g>
    <g data-layer="1">
      <path d="M0 500 C220 470 380 505 600 490 C860 470 1100 505 1440 480 V560 H0Z" fill="#FFFDF6" stroke={ink} stroke-width="3" />
    </g>
  </svg>
  {
    clouds.map((c) => (
      <div class="rw-cloud" data-cloud={c.from} data-speed={c.speed} style={`left:${c.x}vw;width:${c.w}px;--drift:${c.d}s`}>
        <svg viewBox="0 0 120 50">
          <path
            d="M14 44 C2 44 2 30 14 29 C12 16 30 12 38 20 C42 6 66 4 72 18 C80 10 98 14 96 28 C110 28 114 44 100 44 Z"
            fill="#FFFDF6"
            stroke={ink}
            stroke-width="2.5"
            stroke-linejoin="round"
          />
        </svg>
      </div>
    ))
  }
  <canvas class="rw-snow" data-snow></canvas>
</div>

<style is:global>
  .journal-world {
    position: relative;
    z-index: 1;
    background: transparent !important;
  }
  .rw {
    position: fixed;
    inset: 0;
    /* behind everything in the page, positioned or not; main's z-index keeps it above the body */
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }
  .rw-sky {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--sky-top, #bfe3f0), var(--sky-bot, #fff3de));
  }
  .rw-peaks {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 62vh;
    min-height: 320px;
  }
  .rw-peaks g {
    transition: transform 0.12s linear;
  }
  .rw-sun {
    position: absolute;
    left: 80vw;
    top: 0;
    width: 92px;
    height: 92px;
    margin: -46px 0 0 -46px;
    border-radius: 50%;
    background: var(--sun, #ffe08a);
    border: 3px solid var(--ink);
    box-shadow: 0 0 0 14px rgb(255 224 138 / 0.25);
    will-change: transform;
  }
  /* the sun and clouds only where there's sky beside the paper */
  @media (max-width: 1100px) {
    .rw-sun,
    .rw-cloud {
      display: none;
    }
  }
  .rw-cloud {
    position: absolute;
    top: 0;
    opacity: 0.85;
    will-change: transform;
  }
  .rw-cloud svg {
    display: block;
    width: 100%;
    animation: rw-drift var(--drift) ease-in-out infinite alternate;
  }
  @keyframes rw-drift {
    to {
      transform: translateX(9vw);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rw-cloud svg {
      animation: none !important;
    }
  }
  @media print {
    .rw {
      display: none;
    }
  }
  .rw-snow {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  import { progressAt } from "../../scripts/climb";

  const root = document.querySelector<HTMLElement>("[data-rw]");
  if (root) {
    const still = root.dataset.still === undefined ? undefined : Number(root.dataset.still);
    const sky = root.querySelector<HTMLElement>("[data-sky]")!;
    const sun = root.querySelector<HTMLElement>("[data-sun]")!;
    const clouds = [...root.querySelectorAll<HTMLElement>("[data-cloud]")];
    const layers = [...root.querySelectorAll<SVGGElement>("[data-layer]")];
    const canvas = root.querySelector<HTMLCanvasElement>("[data-snow]")!;
    const ctx = canvas.getContext("2d")!;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

    // morning -> midday -> late afternoon -> sunset, light enough that ink text always reads
    const STOPS: [number, string, string][] = [
      [0, "#BFE3F0", "#FFF3DE"],
      [0.45, "#B5D6EE", "#FFF0DC"],
      [0.8, "#DCC6D2", "#FFEBD2"],
      [1, "#E9C3BF", "#FFE6C8"],
    ];
    const hex = (h: string) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));
    const mix = (a: string, b: string, t: number) => {
      const [A, B] = [hex(a), hex(b)];
      return `rgb(${A.map((v, i) => Math.round(v + (B[i] - v) * t)).join(",")})`;
    };
    const skyAt = (p: number) => {
      let i = 0;
      while (i < STOPS.length - 2 && p > STOPS[i + 1][0]) i++;
      const [p0, t0, b0] = STOPS[i];
      const [p1, t1, b1] = STOPS[i + 1];
      const t = Math.min(1, Math.max(0, (p - p0) / (p1 - p0)));
      return [mix(t0, t1, t), mix(b0, b1, t)];
    };

    let W = 0,
      H = 0,
      prog = 0,
      lastY = scrollY,
      vel = 0;
    const resize = () => {
      const dpr = Math.min(2, devicePixelRatio || 1);
      W = innerWidth;
      H = innerHeight;
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    resize();
    addEventListener(
      "resize",
      () => {
        resize();
        paint();
      },
      { passive: true },
    );

    const paint = () => {
      prog = still ?? progressAt();
      const [top, bot] = skyAt(prog);
      sky.style.setProperty("--sky-top", top);
      sky.style.setProperty("--sky-bot", bot);
      layers.forEach((g) => g.setAttribute("transform", `translate(0 ${prog * 120 * Number(g.dataset.layer)})`));
      // the sun arcs down and warms, until it's slipping behind the far ridge at the summit
      sun.style.transform = `translate(${-prog * 9}vw, ${(0.13 + prog * 0.5) * H}px)`;
      sun.style.setProperty("--sun", mix("#FFE08A", "#F4844C", Math.max(0, (prog - 0.4) / 0.6)));
      // you climb up through the clouds, so they sink past you
      clouds.forEach((c) => {
        const y = (Number(c.dataset.cloud) / 100 + prog * Number(c.dataset.speed)) * H;
        c.style.transform = `translateY(${y}px)`;
      });
    };
    let queued = false;
    addEventListener(
      "scroll",
      () => {
        if (!queued) {
          queued = true;
          requestAnimationFrame(() => {
            queued = false;
            paint();
          });
        }
      },
      { passive: true },
    );
    paint();

    type P = { x: number; y: number; r: number; vx: number; vy: number; ph: number };
    const flakes: P[] = Array.from({ length: reduced ? 0 : innerWidth < 640 ? 28 : 60 }, () => ({
      x: Math.random() * W,
      y: Math.random() * H,
      r: 1.5 + Math.random() * 2.8,
      vx: 0,
      vy: 0.25 + Math.random() * 0.6,
      ph: Math.random() * 6.28,
    }));
    if (!reduced) {
      let t = 0;
      const loop = () => {
        requestAnimationFrame(loop);
        if (document.hidden) return;
        t += 0.016;
        vel += (scrollY - lastY - vel) * 0.15;
        lastY = scrollY;
        ctx.clearRect(0, 0, W, H);
        ctx.fillStyle = "rgba(255,253,246,.9)";
        for (const f of flakes) {
          f.y += f.vy - vel * 0.12;
          f.x += Math.sin(t + f.ph) * 0.35;
          if (f.y > H + 6) f.y = -6;
          if (f.y < -6) f.y = H + 6;
          if (f.x > W + 6) f.x = -6;
          if (f.x < -6) f.x = W + 6;
          ctx.beginPath();
          ctx.arc(f.x, f.y, f.r, 0, 6.283);
          ctx.fill();
        }
      };
      loop();
    }
  }
</script>
