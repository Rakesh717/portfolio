---
// The world behind a post: a sky that moves from morning toward sunset as you read,
// parallax Himalaya that sink as you climb, drifting snow, and a summit moment at the end.
const ink = "#40302A";
---

<div class="rw" aria-hidden="true" data-rw>
  <div class="rw-sky" data-sky></div>
  <svg class="rw-peaks" viewBox="0 0 1440 560" preserveAspectRatio="xMidYMax slice">
    <g data-layer="0.35">
      <path d="M0 330 L130 250 L230 310 L360 215 L490 300 L610 250 L760 330 L900 240 L1030 310 L1160 235 L1300 300 L1440 250 V560 H0Z" fill="#C9B6C6" opacity=".75" />
    </g>
    <g data-layer="0.7">
      <path d="M0 420 L170 320 L300 390 L470 260 L610 360 L800 200 L930 310 L1080 240 L1230 340 L1440 270 V560 H0Z" fill="#E5D5D6" stroke={ink} stroke-width="3" stroke-linejoin="round" />
      <path d="M800 200 L760 262 L792 276 L772 318 L820 300 L838 258Z M470 260 L440 304 L468 314 L452 350 L492 330Z" fill="#FFFDF6" />
      <path d="M800 200 V135" stroke={ink} stroke-width="4" stroke-linecap="round" />
      <path d="M800 139 l36 11 l-36 11z" fill="#E85D2F" stroke={ink} stroke-width="3" stroke-linejoin="round" />
    </g>
    <g data-layer="1">
      <path d="M0 500 C220 470 380 505 600 490 C860 470 1100 505 1440 480 V560 H0Z" fill="#FFFDF6" stroke={ink} stroke-width="3" />
    </g>
  </svg>
  <canvas class="rw-snow" data-snow></canvas>
  <div class="rw-toast" role="status" data-toast hidden>
    <span class="hand">Summit!</span>
    <strong>8,848 m</strong>
    <span>You read it all the way up.</span>
  </div>
</div>

<style is:global>
  .journal-world {
    position: relative;
    z-index: 1;
    background: transparent !important;
  }
  .rw {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .rw-sky {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--sky-top, #bfe3f0), var(--sky-bot, #fff3de));
  }
  .rw-peaks {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 62vh;
    min-height: 320px;
  }
  .rw-peaks g {
    transition: transform 0.12s linear;
  }
  .rw-snow {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .rw-toast {
    position: absolute;
    left: 50%;
    top: 22%;
    translate: -50% 0;
    display: grid;
    gap: 0.1rem;
    justify-items: center;
    padding: 0.9rem 1.6rem;
    background: var(--color-cream);
    border: 2.5px solid var(--ink);
    border-radius: 20px 26px 20px 28px;
    box-shadow: 5px 6px 0 rgb(64 48 42 / 0.2);
    text-align: center;
    animation: rw-pop 3.6s var(--bounce) both;
  }
  .rw-toast .hand {
    font-size: 1.8rem;
    color: var(--color-rust-deep);
    line-height: 1;
  }
  .rw-toast strong {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 900;
  }
  @keyframes rw-pop {
    0% {
      opacity: 0;
      transform: translateY(24px) scale(0.85);
    }
    12%,
    78% {
      opacity: 1;
      transform: none;
    }
    100% {
      opacity: 0;
      transform: translateY(-14px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rw-toast {
      animation-duration: 0.01s;
      animation-fill-mode: both;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-rw]");
  if (root) {
    const sky = root.querySelector<HTMLElement>("[data-sky]")!;
    const layers = [...root.querySelectorAll<SVGGElement>("[data-layer]")];
    const canvas = root.querySelector<HTMLCanvasElement>("[data-snow]")!;
    const toast = root.querySelector<HTMLElement>("[data-toast]")!;
    const ctx = canvas.getContext("2d")!;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

    // morning -> midday -> late afternoon -> sunset, light enough that ink text always reads
    const STOPS: [number, string, string][] = [
      [0, "#BFE3F0", "#FFF3DE"],
      [0.45, "#B5D6EE", "#FFF0DC"],
      [0.8, "#DCC6D2", "#FFEBD2"],
      [1, "#F2B38A", "#FFE3BC"],
    ];
    const hex = (h: string) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));
    const mix = (a: string, b: string, t: number) => {
      const [A, B] = [hex(a), hex(b)];
      return `rgb(${A.map((v, i) => Math.round(v + (B[i] - v) * t)).join(",")})`;
    };
    const skyAt = (p: number) => {
      let i = 0;
      while (i < STOPS.length - 2 && p > STOPS[i + 1][0]) i++;
      const [p0, t0, b0] = STOPS[i];
      const [p1, t1, b1] = STOPS[i + 1];
      const t = Math.min(1, Math.max(0, (p - p0) / (p1 - p0)));
      return [mix(t0, t1, t), mix(b0, b1, t)];
    };

    let W = 0,
      H = 0,
      prog = 0,
      lastY = scrollY,
      vel = 0;
    const resize = () => {
      const dpr = Math.min(2, devicePixelRatio || 1);
      W = innerWidth;
      H = innerHeight;
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    resize();
    addEventListener("resize", resize, { passive: true });

    const article = document.querySelector<HTMLElement>("article");
    const progress = () => {
      const end = article ? article.getBoundingClientRect().bottom + scrollY : document.documentElement.scrollHeight;
      const max = end - innerHeight;
      return max > 0 ? Math.min(1, Math.max(0, scrollY / max)) : 0;
    };
    const paint = () => {
      prog = progress();
      const [top, bot] = skyAt(prog);
      sky.style.setProperty("--sky-top", top);
      sky.style.setProperty("--sky-bot", bot);
      layers.forEach((g) => g.setAttribute("transform", `translate(0 ${prog * 120 * Number(g.dataset.layer)})`));
    };
    let queued = false;
    addEventListener(
      "scroll",
      () => {
        if (!queued) {
          queued = true;
          requestAnimationFrame(() => {
            queued = false;
            paint();
          });
        }
      },
      { passive: true },
    );
    paint();

    type P = { x: number; y: number; r: number; vx: number; vy: number; ph: number; c?: string; life?: number };
    const flakes: P[] = Array.from({ length: reduced ? 0 : innerWidth < 640 ? 28 : 60 }, () => ({
      x: Math.random() * W,
      y: Math.random() * H,
      r: 1.5 + Math.random() * 2.8,
      vx: 0,
      vy: 0.25 + Math.random() * 0.6,
      ph: Math.random() * 6.28,
    }));
    const bits: P[] = [];
    const COLORS = ["#4CC9F0", "#FFFDF6", "#EF476F", "#06D6A0", "#FFD166"];
    addEventListener("yak:summit", () => {
      toast.hidden = false;
      setTimeout(() => (toast.hidden = true), 3700);
      if (reduced) return;
      for (let i = 0; i < 70; i++)
        bits.push({
          x: W / 2,
          y: H * 0.35,
          r: 3 + Math.random() * 3,
          vx: (Math.random() - 0.5) * 9,
          vy: -2 - Math.random() * 7,
          ph: Math.random() * 6.28,
          c: COLORS[i % COLORS.length],
          life: 1,
        });
    });

    if (!reduced) {
      let t = 0;
      const loop = () => {
        requestAnimationFrame(loop);
        if (document.hidden) return;
        t += 0.016;
        vel += (scrollY - lastY - vel) * 0.15;
        lastY = scrollY;
        ctx.clearRect(0, 0, W, H);
        ctx.fillStyle = "rgba(255,253,246,.9)";
        for (const f of flakes) {
          f.y += f.vy - vel * 0.12;
          f.x += Math.sin(t + f.ph) * 0.35;
          if (f.y > H + 6) f.y = -6;
          if (f.y < -6) f.y = H + 6;
          if (f.x > W + 6) f.x = -6;
          if (f.x < -6) f.x = W + 6;
          ctx.beginPath();
          ctx.arc(f.x, f.y, f.r, 0, 6.283);
          ctx.fill();
        }
        for (let i = bits.length - 1; i >= 0; i--) {
          const b = bits[i];
          b.x += b.vx;
          b.y += b.vy;
          b.vy += 0.22;
          b.vx *= 0.99;
          b.life! -= 0.012;
          if (b.life! <= 0) {
            bits.splice(i, 1);
            continue;
          }
          ctx.globalAlpha = b.life!;
          ctx.fillStyle = b.c!;
          ctx.fillRect(b.x, b.y, b.r * 1.6, b.r);
          ctx.globalAlpha = 1;
        }
      };
      loop();
    }
  }
</script>
