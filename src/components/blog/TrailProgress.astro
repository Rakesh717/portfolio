---
import Yak from "../Yak.astro";
---

<div class="trailbar" aria-hidden="true" data-trailbar>
  <span class="trailbar-alt hand" data-alt>1,400 m</span>
  <div class="trailbar-track">
    <span class="trailbar-fill" data-fill></span>
    <div class="trailbar-yak" data-yak><Yak pose="idle" /></div>
    <svg class="trailbar-flag" viewBox="0 0 20 28" width="20" height="28">
      <path d="M3 27 V2" stroke="#40302A" stroke-width="2.5" stroke-linecap="round" />
      <path d="M3 3 L 18 8 L 3 13 Z" fill="#E85D2F" stroke="#40302A" stroke-width="2" stroke-linejoin="round" />
    </svg>
  </div>
</div>

<style>
  .trailbar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 20;
    height: calc(52px + env(safe-area-inset-bottom));
    padding: 0 28px env(safe-area-inset-bottom) 12px;
    pointer-events: none;
    background: linear-gradient(transparent, rgb(255 243 222 / 0.9) 55%);
  }
  .trailbar-track {
    position: relative;
    height: 100%;
  }
  .trailbar-track::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 8px;
    border-top: 3px dashed rgb(64 48 42 / 0.35);
  }
  .trailbar-fill {
    position: absolute;
    left: 0;
    bottom: 8px;
    height: 3px;
    width: 100%;
    transform: scaleX(0);
    transform-origin: left;
    background: var(--color-rust);
    border-radius: 3px;
  }
  .trailbar-yak {
    position: absolute;
    left: -26px;
    bottom: 6px;
    width: 52px;
  }
  @media print {
    .trailbar {
      display: none;
    }
  }
  .trailbar-alt {
    position: absolute;
    right: 14px;
    top: -26px;
    padding: 0.05rem 0.7rem;
    font-size: 1.15rem;
    line-height: 1.4;
    color: var(--ink);
    background: var(--color-cream);
    border: 2px solid var(--ink);
    border-radius: 99px;
  }
  .trailbar-flag {
    position: absolute;
    right: -14px;
    bottom: 6px;
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>("[data-trailbar]");
  if (bar) {
    const fill = bar.querySelector<HTMLElement>("[data-fill]")!;
    const yakBox = bar.querySelector<HTMLElement>("[data-yak]")!;
    const yak = bar.querySelector<SVGElement>(".yak");
    const track = bar.querySelector<HTMLElement>(".trailbar-track")!;
    const article = document.querySelector<HTMLElement>("article");
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let idle: number | undefined;
    let width = track.clientWidth;
    const alt = bar.querySelector<HTMLElement>("[data-alt]")!;
    let summited = false;
    let queued = false;
    const frame = () => {
      queued = false;
      // progress runs to the end of the article, so Yakku summits when the post ends
      const end = article ? article.getBoundingClientRect().bottom + scrollY : document.documentElement.scrollHeight;
      const max = end - innerHeight;
      const p = max > 0 ? Math.min(1, Math.max(0, scrollY / max)) : 0;
      // Kathmandu (1,400 m) to the summit, so reading is the climb
      alt.textContent = `${(Math.round((1400 + p * (8848 - 1400)) / 10) * 10).toLocaleString("en-US")} m`;
      fill.style.transform = `scaleX(${p})`;
      yakBox.style.transform = `translateX(${p * width}px)`;
      const done = p >= 0.995;
      if (done && !summited) {
        summited = true;
        window.dispatchEvent(new CustomEvent("yak:summit"));
      }
      if (reduced) return;
      yak?.setAttribute("data-pose", done ? "celebrate" : "walk");
      clearTimeout(idle);
      idle = window.setTimeout(() => yak?.setAttribute("data-pose", done ? "celebrate" : "idle"), 220);
    };
    const queue = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(frame);
      }
    };
    addEventListener("scroll", queue, { passive: true });
    addEventListener(
      "resize",
      () => {
        width = track.clientWidth;
        queue();
      },
      { passive: true },
    );
    frame();
  }
</script>
