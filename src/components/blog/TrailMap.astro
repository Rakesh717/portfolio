---
// A trail map in the margin. Every heading is a camp placed where it falls in the article,
// and Yakku walks the trail in step with your scroll.
import Yak from "../Yak.astro";
---

<nav class="tmap" aria-label="Trail map: sections of this article" data-tmap hidden>
  <p class="tmap-title hand">Trail map</p>
  <div class="tmap-rail" data-rail>
    <span class="tmap-line" aria-hidden="true"></span>
    <span class="tmap-fill" aria-hidden="true" data-fill></span>
    <ol class="tmap-list" data-list></ol>
    <div class="tmap-yak" aria-hidden="true" data-yak><Yak pose="walk" /></div>
  </div>
</nav>

<style is:global>
  .tmap {
    position: fixed;
    top: 7.5rem;
    right: calc(50% + 23rem + 1.6rem);
    width: 12.5rem;
    z-index: 2;
    display: none;
  }
  @media (min-width: 1240px) {
    .tmap:not([hidden]) {
      display: block;
    }
  }
  .tmap-title {
    margin: 0 0 0.6rem;
    padding-right: 0.9rem;
    font-size: 1.5rem;
    color: var(--color-rust-deep);
    text-align: right;
  }
  .tmap-rail {
    position: relative;
    margin-right: 0.9rem;
  }
  .tmap-line,
  .tmap-fill {
    position: absolute;
    right: -0.9rem;
    top: 0;
    width: 0;
    translate: 50% 0;
  }
  .tmap-line {
    bottom: 0;
    border-left: 3px dashed rgb(64 48 42 / 0.3);
  }
  .tmap-fill {
    height: 0;
    border-left: 3px solid var(--color-rust);
  }
  .tmap-list {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tmap-list li {
    position: absolute;
    right: 0;
    left: 0;
    text-align: right;
  }
  .tmap-list a {
    position: relative;
    display: block;
    padding: 0 0.35rem 0 0;
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-ink-soft);
    text-decoration: none;
    transition: color 0.2s;
  }
  .tmap-list a::after {
    content: "";
    position: absolute;
    right: -0.9rem;
    top: 0.1rem;
    width: 12px;
    height: 12px;
    translate: 50% 0;
    background: var(--color-cream);
    border: 2.5px solid var(--ink);
    border-radius: 50%;
    transition:
      background 0.2s,
      transform 0.3s var(--bounce);
  }
  .tmap-list a:hover {
    color: var(--ink);
  }
  .tmap-list a.here {
    color: var(--ink);
    font-weight: 800;
  }
  .tmap-list a.here::after {
    background: var(--color-rust);
    transform: scale(1.3);
  }
  .tmap-list a.passed::after {
    background: var(--color-butter);
  }
  .tmap-yak {
    position: absolute;
    right: -0.9rem;
    top: 0;
    width: 40px;
    margin: -30px -20px 0 0;
    pointer-events: none;
    will-change: transform;
  }
</style>

<script>
  import { READING_LINE } from "../../scripts/climb";

  const nav = document.querySelector<HTMLElement>("[data-tmap]");
  const article = document.querySelector<HTMLElement>("article");
  const heads = [...document.querySelectorAll<HTMLElement>(".prose-trail h2[id]")];
  if (nav && article && heads.length >= 3) {
    const rail = nav.querySelector<HTMLElement>("[data-rail]")!;
    const list = nav.querySelector<HTMLElement>("[data-list]")!;
    const fill = nav.querySelector<HTMLElement>("[data-fill]")!;
    const yakBox = nav.querySelector<HTMLElement>("[data-yak]")!;
    const yak = nav.querySelector<SVGElement>(".yak");
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const links = heads.map((h) => {
      const li = document.createElement("li");
      const a = document.createElement("a");
      a.href = `#${h.id}`;
      a.textContent = h.textContent!.replace(/^#?\s*(\d+\.\s*)?/, "");
      li.append(a);
      list.append(li);
      return { li, a };
    });
    nav.hidden = false;

    const GAP = 58; // minimum px between camps so three-line labels never collide
    let H = 0;
    let docs: number[] = []; // each camp's position in the page
    let ys: number[] = []; // each camp's position on the rail
    let start = 0;
    let end = 0;

    // camps sit where they fall in the article, nudged apart where they would crowd
    const layout = () => {
      const top = article.getBoundingClientRect().top + scrollY;
      start = top;
      end = top + article.offsetHeight;
      docs = heads.map((h) => h.getBoundingClientRect().top + scrollY);
      H = Math.max(Math.min(innerHeight * 0.66, 520), (heads.length - 1) * GAP + 28);
      const span = Math.max(1, end - start);
      ys = docs.map((d) => Math.min(H - 14, Math.max(14, ((d - start) / span) * H)));
      for (let i = 1; i < ys.length; i++) ys[i] = Math.max(ys[i], ys[i - 1] + GAP);
      for (let i = ys.length - 2; i >= 0; i--) ys[i] = Math.min(ys[i], ys[i + 1] - GAP);
      ys[0] = Math.max(14, ys[0]);
      rail.style.height = `${H}px`;
      links.forEach(({ li }, i) => (li.style.top = `${ys[i] - 8}px`));
      update();
    };

    // reading line -> rail position, interpolated between camps so the marker glides
    const markerY = (line: number) => {
      const xs = [start, ...docs, end];
      const yv = [0, ...ys, H];
      if (line <= xs[0]) return 0;
      for (let i = 1; i < xs.length; i++) {
        if (line <= xs[i]) {
          const t = (line - xs[i - 1]) / Math.max(1, xs[i] - xs[i - 1]);
          return yv[i - 1] + t * (yv[i] - yv[i - 1]);
        }
      }
      return H;
    };

    let queued = false;
    let idle: number | undefined;
    function update() {
      queued = false;
      const line = scrollY + innerHeight * READING_LINE;
      const y = markerY(line);
      fill.style.height = `${y}px`;
      yakBox.style.transform = `translateY(${y}px)`;
      let cur = -1;
      docs.forEach((d, i) => {
        if (d <= line) cur = i;
      });
      links.forEach(({ a }, i) => {
        a.classList.toggle("here", i === cur);
        a.classList.toggle("passed", i < cur);
        if (i === cur) a.setAttribute("aria-current", "location");
        else a.removeAttribute("aria-current");
      });
      if (!reduced) {
        yak?.setAttribute("data-pose", "walk");
        clearTimeout(idle);
        idle = window.setTimeout(() => yak?.setAttribute("data-pose", "idle"), 220);
      }
    }
    addEventListener(
      "scroll",
      () => {
        if (!queued) {
          queued = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    addEventListener("resize", layout, { passive: true });
    // fonts, images and the interactive widgets all change the article's height
    new ResizeObserver(layout).observe(article);
    layout();
  }
</script>
