---
import "@fontsource-variable/fraunces/full.css";
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/caveat";
import "../styles/global.css";
import { links, site } from "../data/content";

interface Props {
  title: string;
  description: string;
  /** "trek" = the side-scrolling home page, "journal" = reading pages */
  mode?: "trek" | "journal";
}

const { title, description, mode = "journal" } = Astro.props;
// canonical + absolute URLs only work once `site` is set in astro.config.mjs
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  jobTitle: site.title,
  worksFor: { "@type": "Organization", name: "Binary Digits" },
  address: { "@type": "PostalAddress", addressLocality: "Kathmandu", addressCountry: "NP" },
  sameAs: links.filter((l) => l.href.startsWith("http")).map((l) => l.href),
  ...(canonical && { url: canonical }),
};
---

<!doctype html>
<html lang="en" class={`mode-${mode}`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FFF3DE" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {
      mode === "trek" && (
        <script is:inline>
          if (
            !location.search.includes("static=1") &&
            !matchMedia("(prefers-reduced-motion: reduce)").matches
          )
            document.documentElement.classList.add("trek-on");
        </script>
      )
    }
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content={mode === "trek" ? "website" : "article"} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {mode === "trek" && <script type="application/ld+json" set:html={JSON.stringify(person)} />}
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
